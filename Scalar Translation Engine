<style>
  :root {
    --bg: #0a0a0f;
    --bg-panel: #111118;
    --bg-panel-hover: #1a1a24;
    --gold: #c8a04e;
    --gold-dim: #8a7340;
    --gold-glow: rgba(200,160,78,0.15);
    --text: #e8e6e3;
    --text-dim: #8a8a8a;
    --coherence: #c8a04e;
    --decoherence: #ff4444;
    --harmonic: #44ccff;
    --neutral: #888888;
    --water: #4488ff;
    --soil: #44aa44;
    --body: #cc66cc;
    --border: #22222a;
  }
  
  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding: 20px;
  }
  
  .scalar-engine {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  header {
    text-align: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  
  header h1 {
    font-size: 1.6rem;
    letter-spacing: 4px;
    color: var(--gold);
    text-shadow: 0 0 20px var(--gold-glow);
  }
  
  header .subtitle {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 3px;
    margin-top: 4px;
  }
  
  .kingdom-tabs {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .kingdom-tab {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 10px 24px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    letter-spacing: 2px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .kingdom-tab:hover {
    background: var(--bg-panel-hover);
    color: var(--text);
  }
  
  .kingdom-tab.active {
    border-color: var(--gold);
    color: var(--gold);
    box-shadow: 0 0 15px var(--gold-glow);
  }
  
  .kingdom-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10%;
    width: 80%;
    height: 2px;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
  }
  
  .kingdom-indicator {
    text-align: center;
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 2px;
  }
  
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 16px;
    min-height: 380px;
  }
  
  @media (max-width: 900px) {
    .main-grid { grid-template-columns: 1fr; }
  }
  
  .panel {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .panel h3 {
    font-size: 0.75rem;
    letter-spacing: 3px;
    color: var(--gold-dim);
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  
  .waveform-container {
    flex: 1;
    background: #06060a;
    border-radius: 6px;
    position: relative;
    overflow: hidden;
    min-height: 140px;
  }
  
  #waveform {
    width: 100%;
    height: 100%;
    display: block;
  }
  
  .controls {
    display: flex;
    gap: 8px;
  }
  
  .controls button, .controls select {
    flex: 1;
    padding: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    letter-spacing: 1px;
  }
  
  .controls button {
    background: rgba(200,160,78,0.1);
    border-color: var(--gold-dim);
    color: var(--gold);
  }
  
  .controls button:hover {
    background: rgba(200,160,78,0.2);
  }
  
  .controls button.recording {
    animation: pulse 1s infinite;
    border-color: var(--decoherence);
    color: var(--decoherence);
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  
  .field-data {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-family: monospace;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  
  .field-data span { display: block; }
  .field-data .label { color: var(--gold-dim); }
  .field-data .value { color: var(--text); }
  
  #bsnsStaff {
    flex: 1;
    width: 100%;
    min-height: 200px;
  }
  
  .legend {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 0.65rem;
    justify-content: center;
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-dim);
  }
  
  .legend-shape {
    width: 10px;
    height: 10px;
  }
  
  .scalar-map {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .scalar-item {
    background: rgba(0,0,0,0.3);
    border-left: 3px solid var(--neutral);
    padding: 8px 10px;
    border-radius: 0 4px 4px 0;
    font-size: 0.75rem;
    transition: all 0.3s;
  }
  
  .scalar-item.coherence { border-left-color: var(--coherence); }
  .scalar-item.decoherence { border-left-color: var(--decoherence); }
  .scalar-item.harmonic { border-left-color: var(--harmonic); }
  .scalar-item.neutral { border-left-color: var(--neutral); }
  
  .scalar-item .sym { font-weight: bold; margin-right: 6px; }
  .scalar-item.coherence .sym { color: var(--coherence); }
  .scalar-item.decoherence .sym { color: var(--decoherence); }
  .scalar-item.harmonic .sym { color: var(--harmonic); }
  .scalar-item.neutral .sym { color: var(--neutral); }
  
  .narrative-panel {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .narrative-panel h3 {
    font-size: 0.75rem;
    letter-spacing: 3px;
    color: var(--gold-dim);
  }
  
  #narrative {
    font-family: Georgia, serif;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text);
    min-height: 80px;
    padding: 16px;
    background: rgba(0,0,0,0.3);
    border-radius: 6px;
    border-left: 3px solid var(--gold);
  }
  
  #narrative .cursor {
    display: inline-block;
    width: 8px;
    height: 1.2em;
    background: var(--gold);
    animation: blink 1s infinite;
    vertical-align: text-bottom;
    margin-left: 2px;
  }
  
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  
  #awakenBtn {
    align-self: center;
    padding: 14px 48px;
    background: linear-gradient(135deg, rgba(200,160,78,0.15), rgba(200,160,78,0.05));
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 1rem;
    letter-spacing: 4px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s;
    text-shadow: 0 0 10px var(--gold-glow);
  }
  
  #awakenBtn:hover {
    background: linear-gradient(135deg, rgba(200,160,78,0.3), rgba(200,160,78,0.1));
    box-shadow: 0 0 30px var(--gold-glow);
    transform: translateY(-1px);
  }
  
  .progress-bar {
    width: 100%;
    height: 3px;
    background: var(--bg);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 4px;
  }
  
  .progress-fill {
    height: 100%;
    background: var(--gold);
    width: 0%;
    transition: width 0.3s;
  }
</style>
