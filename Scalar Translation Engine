function drawNotation(data) {
  const svg = document.getElementById('bsnsStaff');
  svg.innerHTML = '';
  const w = 600, h = 240;
  const k = kingdoms[currentKingdom];
  const lines = k.staffLines;
  const margin = { top: 30, bottom: 30, left: 40, right: 20 };
  const staffH = h - margin.top - margin.bottom;
  const lineSpacing = staffH / (lines + 1);
  
  // Staff lines
  for (let i = 0; i < lines; i++) {
    const y = margin.top + (i + 1) * lineSpacing;
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', margin.left);
    line.setAttribute('y1', y);
    line.setAttribute('x2', w - margin.right);
    line.setAttribute('y2', y);
    line.setAttribute('stroke', '#333');
    line.setAttribute('stroke-width', '1');
    svg.appendChild(line);
  }
  
  // Envelope
  if (data.envelope) {
    const envPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    let d = `M ${margin.left} ${margin.top + staffH/2}`;
    data.envelope.forEach((pt, i) => {
      const x = margin.left + pt.x * (w - margin.left - margin.right) / Math.max(...data.envelope.map(p => p.x));
      const y = margin.top + staffH/2 - pt.y * staffH * 0.4;
      d += ` L ${x} ${y}`;
    });
    envPath.setAttribute('d', d);
    envPath.setAttribute('fill', 'none');
    envPath.setAttribute('stroke', k.color);
    envPath.setAttribute('stroke-width', '2');
    envPath.setAttribute('stroke-dasharray', '5,5');
    envPath.setAttribute('opacity', '0.5');
    svg.appendChild(envPath);
  }
  
  // Notes
  const maxT = Math.max(...data.notes.map(n => n.t));
  data.notes.forEach((note, i) => {
    const x = margin.left + (note.t / (maxT + 0.2)) * (w - margin.left - margin.right);
    const y = margin.top + staffH - note.f * staffH * 0.8;
    const size = 8 + note.amp * 6;
    const color = note.type === 'diamond' ? k.color :
                  note.type === 'square' ? '#ff4444' :
                  note.type === 'triangle' ? '#44ccff' : '#888888';
    
    let shape;
    if (note.type === 'circle') {
      shape = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      shape.setAttribute('cx', x);
      shape.setAttribute('cy', y);
      shape.setAttribute('r', size/2);
    } else if (note.type === 'square') {
      shape = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      shape.setAttribute('x', x - size/2);
      shape.setAttribute('y', y - size/2);
      shape.setAttribute('width', size);
      shape.setAttribute('height', size);
    } else if (note.type === 'diamond') {
      shape = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      shape.setAttribute('points', `${x},${y-size/2} ${x+size/2},${y} ${x},${y+size/2} ${x-size/2},${y}`);
    } else if (note.type === 'triangle') {
      shape = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      shape.setAttribute('points', `${x},${y-size/2} ${x-size/2},${y+size/2} ${x+size/2},${y+size/2}`);
    }
    
    shape.setAttribute('fill', color);
    shape.setAttribute('stroke', color);
    shape.setAttribute('stroke-width', '1');
    shape.setAttribute('opacity', '0.9');
    svg.appendChild(shape);
    
    // Arrow
    const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    arrow.setAttribute('x', x);
    arrow.setAttribute('y', y - size/2 - 4);
    arrow.setAttribute('text-anchor', 'middle');
    arrow.setAttribute('fill', '#666');
    arrow.setAttribute('font-size', '10');
    arrow.textContent = note.arrow;
    svg.appendChild(arrow);
    
    // Superscript
    if (note.sup) {
      const sup = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      sup.setAttribute('x', x + size/2 + 4);
      sup.setAttribute('y', y - size/2);
      sup.setAttribute('fill', k.color);
      sup.setAttribute('font-size', '9');
      sup.setAttribute('font-weight', 'bold');
      sup.textContent = note.sup;
      svg.appendChild(sup);
    }
    
    // Syllable brackets
    if (i === 0 || note.syllable !== data.notes[i-1].syllable) {
      const bracketY = margin.top + staffH + 15;
      const bracket = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      bracket.setAttribute('x', x);
      bracket.setAttribute('y', bracketY);
      bracket.setAttribute('fill', '#555');
      bracket.setAttribute('font-size', '11');
      bracket.textContent = '[';
      svg.appendChild(bracket);
    }
    if (i === data.notes.length - 1 || note.syllable !== data.notes[i+1].syllable) {
      const bracketY = margin.top + staffH + 15;
      const bracket = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      bracket.setAttribute('x', x);
      bracket.setAttribute('y', bracketY);
      bracket.setAttribute('fill', '#555');
      bracket.setAttribute('font-size', '11');
      bracket.textContent = ']';
      svg.appendChild(bracket);
    }
  });
}

