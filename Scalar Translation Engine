function drawLegend() {
  const legend = document.getElementById('legend');
  legend.innerHTML = '';
  kingdoms[currentKingdom].legend.forEach(item => {
    const div = document.createElement('div');
    div.className = 'legend-item';
    const shape = document.createElement('div');
    shape.className = 'legend-shape';
    shape.style.background = item.color;
    if (item.shape === 'diamond') {
      shape.style.transform = 'rotate(45deg)';
    } else if (item.shape === 'triangle') {
      shape.style.clipPath = 'polygon(50% 0%, 0% 100%, 100% 100%)';
      shape.style.background = item.color;
    } else if (item.shape === 'circle') {
      shape.style.borderRadius = '50%';
    }
    div.appendChild(shape);
    div.appendChild(document.createTextNode(item.label));
    legend.appendChild(div);
  });
}

// ===================== WAVEFORM =====================
function drawWaveform() {
  const canvas = document.getElementById('waveform');
  const ctx = canvas.getContext('2d');
  
  function resize() {
    const rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;
  }
  resize();
  window.addEventListener('resize', resize);
  
  let time = 0;
  function animate() {
    const w = canvas.width;
    const h = canvas.height;
    ctx.fillStyle = '#06060a';
    ctx.fillRect(0, 0, w, h);
    
    // Grid
    ctx.strokeStyle = '#1a1a24';
    ctx.lineWidth = 1;
    for (let i = 0; i < 5; i++) {
      const y = h * (i + 1) / 6;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }
    
    // Waveform
    ctx.strokeStyle = currentKingdom === 'air' ? '#c8a04e' : 
                      currentKingdom === 'water' ? '#4488ff' :
                      currentKingdom === 'soil' ? '#44aa44' : '#cc66cc';
    ctx.lineWidth = 2;
    ctx.beginPath();
    
    const baseAmp = isCapturing ? 0.4 + Math.random() * 0.3 : 0.05;
    for (let x = 0; x < w; x++) {
      const freq = isCapturing ? 3 + Math.sin(time * 0.01) * 2 : 1;
      const y = h/2 + Math.sin(x * 0.02 * freq + time) * h * baseAmp * 0.4 
                + Math.sin(x * 0.05 * freq + time * 1.3) * h * baseAmp * 0.2;
      if (x === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
    
    // Glow effect
    ctx.shadowColor = ctx.strokeStyle;
    ctx.shadowBlur = 10;
    ctx.stroke();
    ctx.shadowBlur = 0;
    
    time += 0.05;
    waveformAnim = requestAnimationFrame(animate);
  }
  animate();
}

function toggleCapture() {
  const btn = document.getElementById('recordBtn');
  isCapturing = !isCapturing;
  btn.classList.toggle('recording', isCapturing);
  btn.textContent = isCapturing ? '◉ STOP' : '◉ CAPTURE';
  
  if (isCapturing) {
    let progress = 0;
    captureInterval = setInterval(() => {
      progress += 2;
      document.getElementById('progressFill').style.width = progress + '%';
      if (progress >= 100) {
        clearInterval(captureInterval);
        isCapturing = false;
        btn.classList.remove('recording');
        btn.textContent = '◉ CAPTURE';
        document.getElementById('progressFill').style.width = '0%';
      }
    }, 50);
  } else {
    clearInterval(captureInterval);
    document.getElementById('progressFill').style.width = '0%';
  }
}

